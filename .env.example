# Solana mainnet RPC used by the check engine
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# x402 payments
MINDA_PAY_TO=0xYourUsdcReceivingAddress
X402_NETWORK=base
# Optional; defaults to the package's public facilitator (https://x402.org/facilitator, testnets only)
X402_FACILITATOR_URL=

# Report persistence
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# Gates /api/check/free (remove before submission)
MINDA_DEV_KEY=change-me
